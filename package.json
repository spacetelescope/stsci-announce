{
  "name": "stsci-announce",
  "version": "0.8.0",
  "description": "A JupyterLab extension.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/spacetelescope/stsci-announce",
  "bugs": {
    "url": "https://github.com/spacetelescope/stsci-announce/issues"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "Josh Geden",
    "email": "jgeden@lbl.gov"
  },
  "maintainers": [
    {
      "name": "Todd Miller",
      "e-mail": "jmiller@stsci.edu"
    }
  ],
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,.js,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
    "schema/*.json",
    "style/index.js"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/spacetelescope/stsci-announce.git"
  },
  "scripts": {
    "build": "jlpm run build:lib && jlpm run build:labextension:dev",
    "build:labextension": "jupyter-builder build .",
    "build:labextension:dev": "jupyter-builder build --development True .",
    "build:lib": "tsc",
    "build:prod": "jlpm run clean && jlpm run build:lib && jlpm run build:labextension",
    "clean": "jlpm run clean:lib",
    "clean:all": "jlpm run clean:lib && jlpm run clean:labextension",
    "clean:labextension": "rimraf stsci_announce/labextension",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "eslint": "eslint . --fix",
    "eslint:check": "eslint .",
    "install:extension": "jlpm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint .",
    "watch": "run-p watch:src watch:labextension",
    "watch:labextension": "jupyter-builder watch .",
    "watch:src": "tsc -w"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.5.0",
    "@jupyterlab/apputils": "^4.5.0",
    "@jupyterlab/services": "^7.5.0",
    "@jupyterlab/settingregistry": "^4.5.0",
    "@jupyterlab/statusbar": "^4.5.0",
    "@jupyterlab/ui-components": "^4.5.0",
    "@lumino/widgets": "^2.0.0",
    "dompurify": "^3.2.4"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.5.0",
    "@types/json-schema": "^7.0.11",
    "@types/react": "^18.3.31",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "webpack": "^5.103.0",
    "webpack-cli": "^7.2.3"
  },
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "jupyterlab": {
    "extension": true,
    "outputDir": "stsci_announce/labextension",
    "schemaDir": "schema"
  }
}
